log:
  level: TRACE
web:
  host: 0.0.0.0
  port: 3000
  username: admin
  password: admin
dashboard:
  # debug: true starts the Vite dev server automatically (needs
  # `cd frontend && npm install` once) and proxies the dashboard to it, so the
  # UI hot-reloads without rebuilding. In production leave it false and build
  # the dashboard with `make frontend`.
  debug: false
  # Port for the automatically started dev server (default 3000).
  dev_port: 3000
database:
  engine: sqlite
  sqlite:
    file: ./data/skibot.sqlite
  pgsql:
    connectionString: postgres://user:password@localhost:5432/skibot
    pool:
      min: 2
      max: 10
  message_retention_days: 0
  cleanup_time: "01:00"
  timezone: ""

# Out-of-process plugins (see docs/plugin-system.md).
plugins:
  permissions:
    # declared: grant every capability the plugin declares in its manifest
    # safe:     like declared, but db / message.send need an explicit grant
    # strict:   only grant the capabilities listed under grants
    mode: declared
    grants: {}
    deny: {}

# Bot configuration example (place in config/bots/<name>.yml):
# name: Bot-1
# self_id: 12345
# prefix:
#   - /
#   - "!"
# error_reply_enabled: true
# admin:
#   - "onebotHttp:123456"   # adapter_id:user_id elevated to BOT_ADMIN
# adapters:
#   - type: onebotHttp
#     config:
#       api_url: http://127.0.0.1:5700
#       # Optional OneBot v11 HMAC-SHA1 secret validating inbound reports.
#       secret: ""
#       # Optional OneBot v11 access token for outbound HTTP API requests.
#       access_token: ""
#   - type: webchat
#     config:
#       port: 8080
#       host: 0.0.0.0
# plugin_config:
#   help:
#     enabled: true
#   example-go:
#     enabled: true
#     greeting: "Hello from Go"
