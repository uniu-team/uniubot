{
  "id": "example-go",
  "name": "Example Go Plugin",
  "version": "1.0.0",
  "description": "Reference Go plugin showing commands, host RPC calls and scoped storage",
  "author": "uniubot",
  "protocol": "jsonrpc-2.0-ndjson",
  "apiVersion": "v1",
  "runtime": "go",
  "command": "./plugin",
  "args": [],
  "enabled": true,
  "capabilities": [
    "logger",
    "config.read",
    "bot.info",
    "command.list",
    "message.reply",
    "db"
  ],
  "concurrency": 4,
  "timeoutMs": 5000,
  "restart": {
    "maxAttempts": 2,
    "backoffMs": 500
  }
}
