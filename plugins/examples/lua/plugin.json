{
  "id": "example-lua",
  "name": "Example Lua Plugin",
  "version": "1.0.0",
  "description": "Reference Lua plugin using the JSON-RPC protocol with a plain interpreter",
  "author": "uniubot",
  "protocol": "jsonrpc-2.0-ndjson",
  "apiVersion": "v1",
  "runtime": "lua",
  "command": "lua",
  "args": ["main.lua"],
  "enabled": true,
  "capabilities": [
    "logger",
    "config.read",
    "bot.info",
    "command.list",
    "message.reply",
    "db"
  ],
  "concurrency": 2,
  "timeoutMs": 5000,
  "restart": {
    "maxAttempts": 2,
    "backoffMs": 500
  }
}
